# In Vercel Project Settings -> Environment Variables (Production)
# Recommended: create a Discord webhook in #upcoming-p2e (Edit Channel -> Integrations -> Webhooks).
DISCORD_WEBHOOK_URL=
# Alternative: reuse the existing Server Manager bot. Leave webhook URL empty for this mode.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Generate with Node: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Upstash Redis: database -> REST connection details
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Posting controls
MAX_POSTS_PER_RUN=3
# Auto-expire previously posted/seeded article IDs after 90 days (Redis TTL)
SEEN_RETENTION_DAYS=90
NEWS_MAX_AGE_DAYS=7
# Event must be today through the next 90 days; no dated event = skip.
UPCOMING_WINDOW_DAYS=90
UPCOMING_TIMEZONE=Asia/Manila
# baseline (recommended): first scan saves current items and posts zero messages.
# post: first scan can announce up to MAX_POSTS_PER_RUN recent articles.
FIRST_RUN_MODE=baseline

# Optional: extra public RSS/Atom feeds, comma-separated (not HTML pages).
# RSS_FEED_URLS=https://publisher.example/feed.xml,https://other.example/rss
RSS_FEED_URLS=
