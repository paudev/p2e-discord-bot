# Provided by the Firecrawl Vercel Marketplace integration.
FIRECRAWL_API_KEY=
# Discord -> channel -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=
# Optional alternative to a webhook:
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Vercel Settings -> Environment Variables (Production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
# Discovery settings
UPCOMING_WINDOW_DAYS=90
UPCOMING_TIMEZONE=Asia/Manila
FIRST_RUN_MODE=baseline
MAX_POSTS_PER_RUN=5
# Each hourly/4-hour scan checks up to 2 additional detail pages (costs Firecrawl credits)
MAX_DETAIL_PAGES_PER_RUN=2
SEEN_RETENTION_DAYS=90
